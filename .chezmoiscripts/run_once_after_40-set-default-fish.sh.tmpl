{{- if and (not .isWindows) .setFishAsDefault -}}
#!/bin/sh
set -eu

fish_path="$(command -v fish || true)"
if [ -z "$fish_path" ]; then
    printf '%s\n' "Fish is not installed; the default shell was not changed." >&2
    exit 0
fi

if [ "${SHELL:-}" = "$fish_path" ]; then
    exit 0
fi

if [ -r /etc/shells ] && ! grep -qxF "$fish_path" /etc/shells; then
    printf '%s\n' "$fish_path is not listed in /etc/shells; add it before running chsh." >&2
    exit 0
fi

printf 'Changing the login shell to %s\n' "$fish_path"
chsh -s "$fish_path"
{{- end }}
