# Managed by chezmoi.
fish_add_path -g "$HOME/bin" "$HOME/.local/bin"

if status is-interactive
    set -gx EDITOR nvim
    set -gx VISUAL nvim
    set -gx PAGER less
    set -gx DOTFILES_PLATFORM {{ .platform | quote }}
    set -gx DOTFILES_MACHINE_ROLE {{ .machineRole | quote }}
{{- if .isWSL }}
    set -gx DOTFILES_WSL 1
    if type -q wslview
        set -gx BROWSER wslview
    end
{{- end }}

    alias ..='cd ..'
    alias ...='cd ../..'
    alias ll='ls -alF'
    alias la='ls -A'
    if type -q eza
        alias l='eza -al --color=always --group-directories-first --icons=always'
    else
        alias l='ls -als --color=auto --group-directories-first'
    end
    alias cm='chezmoi'
    alias cma='chezmoi apply'
    alias cmdiff='chezmoi diff'
    alias cmstatus='chezmoi status'
    alias cmupdate='chezmoi update'
    alias g='git'
    alias gst='git status --short --branch'
    alias gl='git log --oneline --decorate --graph -20'
    alias n='nnn'
    alias v='nvim'

    set -l mise_bin
    if test -x "$HOME/.local/bin/mise"
        set mise_bin "$HOME/.local/bin/mise"
    else if type -q mise
        set mise_bin (command -s mise)
    end

    if test -n "$mise_bin"
        $mise_bin activate fish | source
        $mise_bin hook-env -s fish | source
    end

    if type -q starship
        starship init fish | source
    end

    if type -q zoxide
        zoxide init fish | source
    end
end
