# Fish shell aliases — kept in sync with Bash/Zsh aliases in
# ~/.config/shell/aliases.sh.

function .. --description 'cd ..'; cd ..; end
function ... --description 'cd ../..'; cd ../..; end
function ll --description 'ls -alF'; ls -alF $argv; end
function la --description 'ls -A'; ls -A $argv; end
function l --description 'ls -CF'; ls -CF $argv; end
function cm --description 'chezmoi'; chezmoi $argv; end
function cma --description 'chezmoi apply'; chezmoi apply $argv; end
function cmdiff --description 'chezmoi diff'; chezmoi diff $argv; end
function cmstatus --description 'chezmoi status'; chezmoi status $argv; end
function cmupdate --description 'chezmoi update'; chezmoi update $argv; end
function g --description 'git'; git $argv; end
function gst --description 'git status --short --branch'; git status --short --branch $argv; end
function gl --description 'git log --oneline --decorate --graph -20'; git log --oneline --decorate --graph -20 $argv; end
function n --description 'nnn'; nnn $argv; end
function v --description 'nvim'; nvim $argv; end

# Restore the old startup screen (default greeting).
set -g fish_greeting "Welcome to fish, the friendly interactive shell"
