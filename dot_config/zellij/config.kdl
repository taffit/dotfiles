keybinds {
    shared_except "locked" {
        bind "Alt a" { GoToTab 1; }
        bind "Alt s" { GoToTab 2; }
        bind "Alt d" { GoToTab 3; }
        bind "Alt f" { GoToTab 4; }
        bind "Alt t" { NewTab; }

        bind "Alt Shift f" { ToggleFloatingPanes; }
        bind "Alt e" { ToggleActiveSyncTab; }
        bind "Alt j" { FocusNextPane; }
        bind "Alt k" { FocusPreviousPane; }
        bind "Alt \\" "Alt |" "Alt Shift \\" "Alt v" { NewPane "Right"; }
        bind "Alt -" "Alt _" "Alt Shift -" "Alt h" { NewPane "Down"; }
        bind "Alt m" { ToggleFocusFullscreen; }
        bind "Alt x" { CloseTab; }
    }
}
