# Shared environment for Bash and Zsh.
for user_bin in "$HOME/bin" "$HOME/.local/bin"; do
    if [ -d "$user_bin" ]; then
        case ":$PATH:" in
            *":$user_bin:"*) ;;
            *) PATH="$user_bin:$PATH" ;;
        esac
    fi
done
unset user_bin
export PATH

export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export DOTFILES_PLATFORM={{ .platform | quote }}
export DOTFILES_MACHINE_ROLE={{ .machineRole | quote }}

{{- if .isWSL }}
export DOTFILES_WSL=1
if command -v wslview >/dev/null 2>&1; then
    export BROWSER="wslview"
fi
{{- end }}

# User-local environment. This file is intentionally unmanaged.
if [ -f "$HOME/.config/shell/local.sh" ]; then
    . "$HOME/.config/shell/local.sh"
fi
