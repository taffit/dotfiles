# Managed by chezmoi. PowerShell 7 profile.
$env:EDITOR = "nvim"
$env:VISUAL = "nvim"
$env:DOTFILES_PLATFORM = {{ .platform | quote }}
$env:DOTFILES_MACHINE_ROLE = {{ .machineRole | quote }}

if (Get-Command mise -ErrorAction SilentlyContinue) {
    (& mise activate pwsh) | Out-String | Invoke-Expression
    (& mise hook-env -s pwsh) | Out-String | Invoke-Expression
}

if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (& starship init powershell)
}

if (Get-Command zoxide -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (zoxide init powershell | Out-String) })
}

Set-Alias -Name cm -Value chezmoi
Set-Alias -Name g -Value git
Set-Alias -Name v -Value nvim

$localProfile = Join-Path $HOME ".config/powershell/local.ps1"
if (Test-Path $localProfile) {
    . $localProfile
}
